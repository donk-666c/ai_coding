# 复制成 .env 后填入你自己的值。.env 已被 .gitignore 忽略。
# 注意：ZHIPU_API_KEY 只留在后端，前端拿不到。

# 智谱 API Key（形如 xxxxxxxx.xxxxxxxx）
ZHIPU_API_KEY=

# 接口地址（OpenAI 兼容）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 免费模式（重要）=====
# 只允许调用白名单内的模型，清单外的一律拒绝，避免误用付费模型产生费用。
# 依据官方定价页（docs.bigmodel.cn/cn/guide/models/text/glm-4）标注"免费"的文本模型。
GLM_FREE_ONLY=1
GLM_ALLOWED_MODELS=GLM-4.7-Flash,glm-4-flash-250414,glm-4.5-flash,glm-4-flash

# ⚠️ 名字极易混淆的付费模型，千万不要加进白名单：
#    glm-4-flashx（比 glm-4-flash 多一个 x，官方称其为"免费版 GLM-4-Flash 的增强版"，即付费）
#    glm-4-air / glm-4-airx / glm-4-plus / glm-4-flashx-250414

# 主模型（免费）
GLM_MODEL=GLM-4.7-Flash

# 降级链（都免费），逗号分隔。刻意用带日期的 glm-4-flash-250414：
# 裸别名 glm-4-flash 将来可能漂移，而 glm-4-flashx 只多一个 x 却是付费的。
GLM_FALLBACK_MODELS=glm-4-flash-250414,glm-4.5-flash

# ---- 以下都是可选项，不填就用这里的默认值 ----

# 服务监听
HOST=127.0.0.1
PORT=8000
DEBUG=0

# 上游超时（秒）：连接 / 读取。读取超时同时管"等响应头和等下一个分片"，
# 所以它决定了一次挂死的上游最多拖住用户多久，别设太大。
CONNECT_TIMEOUT=10
READ_TIMEOUT=60
# 整条降级链的总时限（秒）：上游只连不答时用它兜底，超过就报错而不是无限等
TOTAL_DEADLINE=120

# 同一个模型遇到 429/5xx 时的重试次数与退避基数（秒）
MAX_RETRIES=2
RETRY_BACKOFF=1.5

# 思考模式：GLM-4.7-Flash 是推理模型，默认会把大量 token 花在思维链上
# （实测一个简单问题就烧掉 404 reasoning tokens），所以默认关掉。
# 取值 disabled（默认，快）/ enabled（开启并展示思维链）/ auto / 留空（不传该参数）
GLM_THINKING=disabled
# 开启思考时，输出预算的下限（思维链和正文共用预算）
THINKING_MIN_MAX_TOKENS=4096

# 生成参数默认值
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
SYSTEM_PROMPT=你是一个专业、友好的中文 AI 助手。回答准确、条理清晰；涉及代码时使用 Markdown 代码块并标注语言。
